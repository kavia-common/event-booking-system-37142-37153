# FastAPI application environment example
# Copy this file to .env and provide the actual values.

# Server
APP_HOST=0.0.0.0
APP_PORT=3001

# Database connection (MySQL)
DB_HOST=localhost
DB_PORT=5001
DB_USER=appuser
DB_PASSWORD=dbuser123
DB_NAME=myapp

# CORS (comma-separated origins, e.g., http://localhost:3000)
CORS_ORIGINS=http://localhost:3000
